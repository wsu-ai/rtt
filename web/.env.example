# 이 파일을 복사해서 ".env.local" 로 만들고, 실제 값을 넣으세요.
# .env.local 은 gitignore 되어 있어 깃에 절대 올라가지 않습니다.

# ── 방·실시간(Supabase) — 학생/교수 공통, 공개되어도 안전한 anon 키 ──
# Supabase 대시보드 > Project Settings > API 에서 복사
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Gemini — 교수자(통역)에서만 필요. 학생은 불필요 ──
# 마이크 음성 인식 + 번역에 사용. 무료 키 발급: https://aistudio.google.com/apikey
# (교수는 홈 🔑 버튼으로 '본인 키'를 따로 넣을 수도 있음 — 그 키는 이 브라우저에만 저장)
VITE_GEMINI_API_KEY=

# ── 교수자 잠금 비밀번호(선택) ──
# 홈 🔒 자물쇠에 입력. 클라이언트 측 캐주얼 차단용(진짜 보안은 방 비밀번호 + Supabase RLS).
# · 일반(강의) 비번 — 코드에 12261105로 고정됨(settings.ts). 여기서 바꿀 수 없음.
# · 개인 모드 바로가기 비번 — 비우면 기본값 0426309660. 입력 즉시 방 없이 '개인 통역' 모드로 직행.
VITE_PERSONAL_PASSCODE=

# ── (참고) 로컬 개발 HTTPS ──
# 기본 `npm run dev` 는 HTTPS(폰에서 LAN IP로 마이크 테스트, 자체서명 인증서).
# 브라우저 미리보기/디버그는 http가 편함:  VITE_HTTPS=0 npm run dev
# (이건 .env 가 아니라 실행 시 셸 환경변수로 전달)
